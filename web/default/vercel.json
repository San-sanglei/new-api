{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun install && bun run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "${API_URL}/api/:path*"
    },
    {
      "source": "/mj/:path*",
      "destination": "${API_URL}/mj/:path*"
    },
    {
      "source": "/pg/:path*",
      "destination": "${API_URL}/pg/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "${API_URL}/v1/:path*"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "${API_URL}/dashboard/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
