# =============================================================================
# 生产环境配置模板 (.env.prod)
# =============================================================================
# ⚠️  严禁将真实生产密钥提交到代码仓库！
# 用法：cp .env.prod.example .env.prod 然后填入真实强密码与密钥
# 加载方式：docker compose --env-file .env.prod up -d
#
# 生产环境要求：
#   - 所有密码必须为强随机值（至少 32 字符）
#   - SESSION_SECRET 必须为不可预测的随机字符串
#   - COOKIE_SECURE 必须为 true（强制 HTTPS）
#   - 数据库使用 PostgreSQL/MySQL，禁止 SQLite
#   - Redis 必须启用并设置密码
#   - 禁止 AllowAllOrigins，使用白名单
# =============================================================================

# ---- 运行模式 ----
DEBUG=false
ENABLE_PPROF=false
GIN_MODE=release

# ---- 数据库（生产环境强制使用 PostgreSQL） ----
# ⚠️  请替换为真实强密码
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
SQL_DSN=postgresql://root:${POSTGRES_PASSWORD}@postgres:5432/new-api

# ---- Redis（生产环境必须启用并设置强密码） ----
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
REDIS_CONN_STRING=redis://:${REDIS_PASSWORD}@redis:6379/0

# ---- 会话密钥（生产环境必须为随机字符串，多节点必须一致） ----
# 生成方式：openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX_STRING

# ---- Cookie 安全（生产环境强制 HTTPS） ----
COOKIE_SECURE=true

# ---- CORS 白名单（生产环境禁止 AllowAllOrigins） ----
# 逗号分隔的可信域名列表
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ---- 可信重定向域名（支付回调等） ----
TRUSTED_REDIRECT_DOMAINS=your-domain.com

# ---- 版本控制（镜像 tag，用于版本追踪与回滚） ----
NEW_API_VERSION=v0.6.0

# ---- 日志 ----
ERROR_LOG_ENABLED=true
NODE_NAME=new-api-prod-1

# ---- 数据库连接池（生产环境配置） ----
SQL_MAX_OPEN_CONNS=100
SQL_MAX_IDLE_CONNS=50
SQL_MAX_LIFETIME=300
SQL_MAX_IDLE_TIME=300
SQL_SLOW_THRESHOLD=200

# ---- 备份保留天数 ----
BACKUP_RETAIN_DAYS=7

# ---- 流式超时 ----
STREAMING_TIMEOUT=300
RELAY_IDLE_CONN_TIMEOUT=90
