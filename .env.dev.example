# =============================================================================
# 开发环境配置模板 (.env.dev)
# =============================================================================
# 用法：cp .env.dev.example .env.dev 然后按需修改
# 加载方式：docker compose --env-file .env.dev up -d
#
# 开发环境特点：
#   - 使用 SQLite，无需外部数据库
#   - Redis 可选关闭
#   - 开启调试模式与 pprof
#   - 允许宽松的 CORS 与 Cookie 设置
# =============================================================================

# ---- 运行模式 ----
DEBUG=true
ENABLE_PPROF=true
GIN_MODE=debug

# ---- 数据库（开发环境使用 SQLite，零依赖） ----
SQLITE_PATH=data/dev.db
# 如需 MySQL/PostgreSQL，取消注释并配置：
# SQL_DSN=root:devpass@tcp(127.0.0.1:3306)/new-api?parseTime=true

# ---- Redis（开发环境可关闭，使用内存缓存） ----
REDIS_ENABLED=false
# REDIS_CONN_STRING=redis://:devpass@127.0.0.1:6379/0

# ---- 会话密钥（开发环境可使用固定值） ----
SESSION_SECRET=dev-session-secret-do-not-use-in-prod

# ---- Cookie 安全（开发环境关闭 Secure 以支持 HTTP） ----
COOKIE_SECURE=false

# ---- CORS（开发环境允许全部来源） ----
# 注意：生产环境禁止使用 AllowAllOrigins

# ---- 日志 ----
ERROR_LOG_ENABLED=true

# ---- 数据库连接池（开发环境缩小规模） ----
SQL_MAX_OPEN_CONNS=20
SQL_MAX_IDLE_CONNS=10
SQL_MAX_LIFETIME=300
SQL_MAX_IDLE_TIME=300
SQL_SLOW_THRESHOLD=500
