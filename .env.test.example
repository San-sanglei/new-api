# =============================================================================
# 测试环境配置模板 (.env.test)
# =============================================================================
# 用法：cp .env.test.example .env.test 然后按需修改
# 加载方式：docker compose --env-file .env.test up -d
#           或运行测试时 export $(cat .env.test | xargs)
#
# 测试环境特点：
#   - 使用独立数据库（不污染开发数据）
#   - Redis 使用独立实例或关闭
#   - 关闭调试模式，模拟生产行为
#   - 使用独立会话密钥
# =============================================================================

# ---- 运行模式 ----
DEBUG=false
ENABLE_PPROF=false
GIN_MODE=test

# ---- 数据库（测试环境使用独立 SQLite 文件，与开发隔离） ----
SQLITE_PATH=data/test.db
# 或使用独立 MySQL/PostgreSQL 实例：
# SQL_DSN=root:testpass@tcp(127.0.0.1:3306)/new-api-test?parseTime=true

# ---- Redis（测试环境使用独立实例） ----
REDIS_ENABLED=false
# REDIS_CONN_STRING=redis://:testpass@127.0.0.1:6380/0

# ---- 会话密钥（测试环境独立密钥） ----
SESSION_SECRET=test-session-secret-isolated

# ---- Cookie 安全（测试环境可关闭以支持 HTTP） ----
COOKIE_SECURE=false

# ---- 日志 ----
ERROR_LOG_ENABLED=true

# ---- 数据库连接池（测试环境最小化） ----
SQL_MAX_OPEN_CONNS=10
SQL_MAX_IDLE_CONNS=5
SQL_MAX_LIFETIME=300
SQL_MAX_IDLE_TIME=300
SQL_SLOW_THRESHOLD=500

# ---- 测试专用标志 ----
# 标记当前为测试环境，代码中可通过 os.Getenv("GIN_MODE") 判断
GO_ENV=test
